FROM python:3.12-slim AS builder
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml setup.py ./
COPY src/ src/
RUN pip install -e ".[xgb,lgbm,opt]" --no-deps && \
    pip install scikit-learn pandas numpy mlflow fastapi uvicorn pydantic pydantic-settings pyyaml structlog httpx

FROM python:3.12-slim AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN pip install scikit-learn pandas numpy mlflow fastapi "uvicorn[standard]" pydantic pydantic-settings pyyaml structlog httpx
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY pyproject.toml setup.py ./
COPY src/ src/
COPY configs/ configs/
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health').raise_for_status()" || exit 1
CMD ["uvicorn", "mlops.serving.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
