FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN pip install scikit-learn pandas numpy mlflow pydantic pydantic-settings pyyaml structlog optuna
COPY pyproject.toml setup.py ./
COPY src/ src/
COPY configs/ configs/
ENTRYPOINT ["python", "-m", "mlops.cli"]
CMD ["pipeline", "--config", "configs/production.yaml"]
